# Copy file này thành .env (đã nằm trong .gitignore). KHÔNG commit .env.
# Các giá trị dưới đây CHỈ dùng cho máy phát triển. Bản deploy phải dùng giá trị khác, mạnh hơn.

# PostgreSQL
POSTGRES_DB=kidcare
POSTGRES_USER=kidcare
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=3000
JWT_ACCESS_SECRET=change_me_access_secret_dev_only
JWT_REFRESH_SECRET=change_me_refresh_secret_dev_only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000
